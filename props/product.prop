# App launch prefetching (IORapd)
ro.iorapd.enable=false
iorapd.perfetto.enable=false
iorapd.readahead.enable=false
persist.device_config.runtime_native_boot.iorap_readahead_enable=false

# Audio
audio.offload.min.duration.secs=30

# Media
media.stagefright.audio.deep=true

# RKPD
remote_provisioning.enable_rkpd=true
remote_provisioning.hostname=remoteprovisioning.googleapis.com

# LMK
ro.lmk.log_stats=false
ro.lmk.debug=false
ro.lmk.use_psi=true
ro.lmk.use_minfree_levels=false
ro.lmk.use_new_strategy=true
ro.lmk.low=900
ro.lmk.medium=768
ro.lmk.critical=512
ro.lmk.critical_upgrade=true
ro.lmk.upgrade_pressure=65
ro.lmk.downgrade_pressure=40
ro.lmk.kill_heaviest_task=false
ro.lmk.kill_timeout_ms=100
ro.lmk.psi_partial_stall_ms=350
ro.lmk.psi_complete_stall_ms=700
ro.lmk.thrashing_limit=90
ro.lmk.thrashing_limit_decay=25
ro.lmk.swap_util_max=80
ro.lmk.swap_free_low_percentage=20
ro.lmk.filecache_min_kb=131072
ro.lmk.stall_limit_critical=3
ro.config.low_ram=false
ro.config.per_app_memcg=true